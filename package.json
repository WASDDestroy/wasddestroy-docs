{
  "packageManager": "pnpm@12.8.1",
  "devDependencies": {
    "@nolebase/vitepress-plugin-enhanced-readabilities": "^2.18.2",
    "@nolebase/vitepress-plugin-highlight-targeted-heading": "^2.18.2",
    "markdownlint-cli2": "^0.23.3",
    "vitepress": "^2.0.0-alpha.20"
  },
  "scripts": {
    "prepare": "node scripts/install-git-hooks.mjs",
    "gen:sidebar": "node scripts/gen-sidebar.mjs",
    "gen:sidebar:check": "node scripts/gen-sidebar.mjs --check --strict",
    "docs:dev": "node scripts/gen-sidebar.mjs && vitepress dev",
    "docs:build": "node scripts/gen-sidebar.mjs && vitepress build",
    "docs:preview": "vitepress preview",
    "lint:md": "markdownlint-cli2",
    "lint:md:fix": "markdownlint-cli2 --fix",
    "resize:md-images": "python scripts/resize-md-images.py",
    "images:webp": "python scripts/convert_images_to_webp.py --all",
    "images:webp:check": "python scripts/convert_images_to_webp.py --all --dry-run",
    "hooks:install": "node scripts/install-git-hooks.mjs"
  },
  "dependencies": {
    "@nolebase/ui": "^2.18.2",
    "@vueuse/core": "^15.0.0",
    "lxgw-wenkai-screen-webfont": "^1.7.0"
  }
}